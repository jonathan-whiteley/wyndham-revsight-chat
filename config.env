# RevSight Chat: the ONE file to edit when you deploy to your own workspace.
#
# Read by every script in scripts/ (sourced as shell) and by the backend for
# local runs and tests. On Databricks Apps the backend gets these values as
# environment variables (deploy.sh writes CATALOG/SCHEMA into the staged
# app.yaml; the warehouse and Genie IDs come from the app's bound resources).
# Keep the format KEY=value, one per line, no spaces around "=".

# Databricks CLI profile from ~/.databrickscfg that points at your workspace.
DATABRICKS_PROFILE=DEFAULT

# Name of the Databricks App (lowercase letters, numbers, dashes). Must be unique in the workspace.
APP_NAME=wyndham-revsight-chat

# Workspace folder the app source is uploaded to. Leave empty to use /Workspace/Users/<you>/apps/<APP_NAME>.
APP_SOURCE_PATH=

# Unity Catalog catalog that holds the RevSight metric views (built by the wyndham-revsight repo).
CATALOG=jdub_demo

# Schema inside CATALOG with mv_nt_performance and mv_str_compset. Usually the one schema you can write to.
SCHEMA=wyndham

# SQL warehouse ID the app is granted CAN_USE on (SQL Warehouses > your warehouse > Overview).
# Use the warehouse your two Genie spaces run on: Genie runs their SQL there as the app's service principal.
WAREHOUSE_ID=0168e23e24e6ae10

# Genie space ID of the "NT Performance" agent (from the space URL: /genie/rooms/<id>).
GENIE_SPACE_NT=01f1c1f3a12c135681e35099eb87cb2a

# Genie space ID of the "STR Comp Set" agent.
GENIE_SPACE_STR=01f1c1f3a21d1a338438c5a06ca2573b

# OAuth scopes the app requests for each signed-in user (on-behalf-of auth). Keep all three: Genie One needs "genie".
USER_API_SCOPES="sql dashboards.genie genie"
